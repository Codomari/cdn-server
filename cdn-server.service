[Unit]
Description=Rust CDN cache server
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/etc/cdn-server/bin/cdn-server
ConditionPathExists=/etc/cdn-server/config.yaml

[Service]
User=cdn
Group=cdn
WorkingDirectory=/etc/cdn-server
Environment=CONFIG_PATH=/etc/cdn-server/config.yaml
ExecStart=/etc/cdn-server/bin/cdn-server
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0027

[Install]
WantedBy=multi-user.target
